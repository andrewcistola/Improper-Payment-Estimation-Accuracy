__pycache__/
*.pyc
.ipynb_checkpoints/
.Rhistory
.RData
.Rproj.user/
.DS_Store
.env
*.log
# Never commit real claims/PHI data
data/raw/
*.sas7bdat

# errors/ outputs: large populations are regenerated (hashes in manifest.json);
# only the small populations are committed (Part C, EIPM)
part-d-ipm/errors/output/**/*.parquet
part-d-ipm/errors/output_pre_ira/**/*.parquet
perm/errors/output/**/*.parquet
cert/errors/output/**/*.parquet
*.egg-info/
.pytest_cache/

# DuckDB spill files from large runs
.tmp/

# per-audit-year report as CSV is large; the same rows are in by_audit_year.parquet
shared/results/report/by_sample.csv
shared/results/report/by_audit_year.csv

# start-here/run_all.py: trial outputs, the snapshot of published results, the run log
start-here/_quick/
start-here/_reference/
start-here/run_log.txt
start-here/logs/
.venv/

# robustness/: rebuilt populations are regenerated (manifests committed); per-state PERM draws are large
robustness/output/**/*.parquet
robustness/results/**/sim_draws.parquet
